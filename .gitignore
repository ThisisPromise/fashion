# Large, reproducible Fashionpedia data -- re-downloadable from the URLs in
# submission/README.md, and submission/data/processed/{images,masks} are
# just prepare_data.py's output from that raw data. Not meaningful to
# version -- ~580MB combined, would bloat the repo for no benefit.
submission/data/fashionpedia/
submission/data/processed/images/
submission/data/processed/masks/

# Same story for fabric-fill-tool: the trained checkpoints ship, the raw
# training images/masks that produced them don't. Reproducible by running
# src/prepare_data_extended.py against the same Fashionpedia data.
fabric-fill-tool/data/
